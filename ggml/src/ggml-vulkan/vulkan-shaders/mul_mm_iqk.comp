    return float(data_b[idx]);
}
#endif

float decode_scalar(const uint row_base_bytes, const uint k) {
    const uint block_base = row_base_bytes + (k / QUANT_K) * IQK_BLOCK_BYTES;
    const uint k_in_super = k % QUANT_K;
    const float d = unpackHalf2x16(get_a_u16(block_base)).x;

#if defined(DATA_A_IQ2_K)
    const uint ib128 = k_in_super / 128u;
    const uint offset = k_in_super % 128u;
    const uint group = offset / 32u;
    const uint pos = offset % 32u;
    const uint il = pos / 2u;
    const uint j = pos % 2u;
    const uint scale_shift = 4u * (il / 8u);
    const float dl = d * float(int((get_a_byte(block_base + 4u + 4u * ib128 + group) >> scale_shift) & 0xfu) - 8);
    const uint extra = (get_a_u16(block_base + 2u) >> (8u * ib128 + il / 8u)) & 0xffu;
    const uint qs = get_a_byte(block_base + 12u + 32u * ib128 + 2u * il + j);
    const uint shift = 2u * group;
    const uint idx = ((qs >> shift) & 3u) + (((extra >> shift) & 1u) << 2u);
    return dl * float(kvalues_iq2nl_const[idx]);
#elif defined(DATA_A_IQ3_K)
    const uint ib128 = k_in_super / 128u;
    const uint offset = k_in_super % 128u;
    const uint group = offset / 32u;
    const uint pos = offset % 32u;
    const uint il = pos / 2u;
    const uint j = pos % 2u;
    const uint scale_shift = 4u * (il / 8u);
    const uint sh = get_a_u16(block_base + 4u) >> (8u * ib128 + il / 8u);
    const int sign = (group == 0u ? (sh & 0x01u) : group == 1u ? (sh & 0x04u) : group == 2u ? (sh & 0x10u) : (sh & 0x40u)) != 0u ? -1 : 1;
    const int mag = 2 * int((get_a_byte(block_base + 6u + 4u * ib128 + group) >> scale_shift) & 0xfu) + 1;
    const uint extra = (get_a_u16(block_base + 2u) >> (8u * ib128 + il / 8u)) & 0xffu;
    const uint qs = get_a_byte(block_base + 14u + 32u * ib128 + 2u * il + j);
    const uint h = get_a_byte(block_base + 78u + 2u * il + j) >> (4u * (ib128 % 2u));
    const uint low = (qs >> (2u * group)) & 3u;
    const uint high = (((group == 0u ? h & 0x01u : group == 1u ? h & 0x02u : group == 2u ? h & 0x04u : h & 0x08u)) >> group) << 2u;
    const uint half_idx = ((extra >> (2u * group)) & 1u) << 3u;
    return d * float(sign * mag) * float(kvalues_iq3nl_const[low | high | half_idx]);
#elif defined(DATA_A_IQ4_K)
    const uint ib = k_in_super / 32u;
    const uint pos = k_in_super % 32u;
    const uint low_half = pos < 16u ? 1u : 0u;
    const uint local = low_half != 0u ? pos : pos - 16u;
    const uint il = local / 4u;
    const uint j = local % 4u;
    const uint q = get_a_byte(block_base + 16u + 16u * ib + 4u * il + j);
    const uint sh = get_a_byte(block_base + 4u + ib / 2u) >> (4u * (ib % 2u));
    const float dl = low_half != 0u
        ? d * float(int((get_a_byte(block_base + 8u + ib) & 0xfu) | ((sh << 4u) & 0x30u)) - 32)
        : d * float(int((get_a_byte(block_base + 8u + ib) >> 4u) | ((sh << 2u) & 0x30u)) - 32);
    const uint extra = get_a_u16(block_base + 2u);
    const uint table_offset = ((extra >> (2u * ib + (low_half != 0u ? 0u : 1u))) & 1u) << 4u;
    return dl * float(kvalues_iq4k_const[table_offset + (low_half != 0u ? (q & 0xfu) : (q >> 4u))]);
#elif defined(DATA_A_IQ5_K)
    const uint ib64 = k_in_super / 64u;
    const uint pos = k_in_super % 64u;
    const uint group = pos / 16u;
    const uint local = pos % 16u;
    const uint il = local / 2u;
    const uint j = local % 2u;
    const uint shift = 2u * (ib64 % 4u);
    const uint extra = get_a_u16(block_base + 2u) >> (4u * (ib64 % 4u));
    const uint q0 = get_a_byte(block_base + 16u + 32u * ib64 + j + (group & 1u) * 16u + 2u * il);
    const uint h0 = get_a_byte(block_base + 144u + j + ((group < 2u) ? 0u : 16u) + 2u * il) >> shift;
    if (group == 0u) {
        const float dl = d * float(int((get_a_byte(block_base + 8u + 2u * ib64 + 0u) & 0xfu) | ((get_a_byte(block_base + 4u + ib64) << 4u) & 0x30u)) - 32);
        return dl * float(kvalues_iq5nl_const[(q0 & 0xfu) | ((h0 & 1u) << 4u) | ((extra << 5u) & 0x20u)]);
    } else if (group == 1u) {
        const float dl = d * float(int((get_a_byte(block_base + 8u + 2u * ib64 + 0u) >> 4u) | ((get_a_byte(block_base + 4u + ib64) << 2u) & 0x30u)) - 32);
        return dl * float(kvalues_iq5nl_const[(q0 & 0xfu) | ((h0 & 1u) << 4u) | ((extra << 4u) & 0x20u)]);
    } else if (group == 2u) {
        const float dl = d * float(int((get_a_byte(block_base + 8u + 2u * ib64 + 1u) & 0xfu) | ((get_a_byte(block_base + 4u + ib64) >> 0u) & 0x30u)) - 32);
        return dl * float(kvalues_iq5nl_const[(q0 >> 4u) | ((h0 & 2u) << 3u) | ((extra << 3u) & 0x20u)]);
    }
    const float dl = d * float(int((get_a_byte(block_base + 8u + 2u * ib64 + 1u) >> 4u) | ((get_a_byte(block_base + 4u + ib64) >> 2u) & 0x30u)) - 32);
    return dl * float(kvalues_iq5nl_const[(q0 >> 4u) | ((h0 & 2u) << 3u) | ((extra << 2u) & 0x20u)]);
#elif defined(DATA_A_IQ6_K)
    const uint ib64 = k_in_super / 64u;
    const uint pos = k_in_super % 64u;
    const uint group = pos / 16u;
    const uint local = pos % 16u;
    const uint il = local / 2u;
    const uint j = local % 2u;
    const uint shift = 4u * (ib64 % 2u);
    const uint extra = get_a_u16(block_base + 2u) >> (4u * ib64);
    const int scale = int(int8_t(get_a_byte(block_base + 4u + 4u * ib64 + group)));
    const uint q = get_a_byte(block_base + 20u + 32u * ib64 + j + ((group & 1u) != 0u ? 16u : 0u) + 2u * il);
    const uint h = get_a_byte(block_base + 148u + 32u * (ib64 / 2u) + j + (group >= 2u ? 16u : 0u) + 2u * il) >> shift;
    const uint table_offset = ((extra >> group) & 1u) << 6u;
    const uint qidx = group < 2u ? (q & 0xfu) : (q >> 4u);
    const uint hidx = group < 2u ? ((h & 0x03u) << 4u) : ((h & 0x0cu) << 2u);
    return d * float(scale) * float(kvalues_iq6nl_const[table_offset + qidx + hidx]);
#else
#error unsupported IQ_K type
#endif
}

void main() {
    const uint ic = gl_WorkGroupID.y;

#ifdef MUL_MAT_ID
    const uint expert_idx = gl_WorkGroupID.z;
    if (ic * BN >= data_expert_count[expert_idx]) {
        return;
    }
#endif

#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

#ifdef MUL_MAT_ID
    if (bitCount(p.nei0) == 1u) {
        load_row_ids(expert_idx, true, ic);
    } else {
        load_row_ids(expert_idx, false, ic);
    }

    if (ic * BN >= _ne1) {
        return;
    }
#else
    const uint batch_idx = gl_WorkGroupID.z + p.base_work_group_z;
    const uint i13 = batch_idx / p.ne12;
    const uint i12 = batch_idx % p.ne12;
    const uint i03 = i13 / p.broadcast3;
    const uint i02 = i12 / p.broadcast2;
    const uint batch_idx_a = i03 * p.ne02 + i02;
#endif

    const uint blocks_m = (p.M + BM - 1u) / BM;
    const uint ir = gl_WorkGroupID.x % blocks_m;
#ifdef MUL_MAT_ID
    const uint ik = 0u;
    const uint start_k = 0u;
    const uint end_k = p.K;
#else
    const uint ik = gl_WorkGroupID.x / blocks_m;
    const uint start_k = ik * p.k_split;
    const uint end_k = min(p.K, (ik + 1u) * p.k_split);
#endif

    const uint local_row = gl_LocalInvocationID.x;
    if (local_row >= BM) {
        return;
    }

    const uint dr = ir * BM + local_row;
    if (dr >= p.M) {
        return;
    }

#ifdef MUL_MAT_ID
    const uint row_base_bytes = expert_idx * p.batch_stride_a + dr * p.stride_a;
#else
    const uint row_base_bytes = batch_idx_a * p.batch_stride_a + dr * p.stride_a;
    const uint offsets = batch_idx * p.batch_stride_d + ik * p.batch_stride_d * p.num_batches;
#endif

    float sums[BN];
    [[unroll]] for (uint col = 0u; col < BN; ++col) {
        sums[col] = 0.0f;
    }

#ifdef B_IS_Q8_1
    for (uint kb = start_k / QUANT_K_Q8_1; kb < end_k / QUANT_K_Q8_1; ++kb) {
        const uint superblock = kb / 8u;
        const uint slice_in_super = kb % 8u;
        const uint block_base = row_base_bytes + superblock * IQK_BLOCK_BYTES;

        [[unroll]] for (uint col = 0u; col < BN; ++col) {
            const uint col_i = ic * BN + col;
#ifdef MUL_MAT_ID
            if (col_i >= _ne1) {
                break;
            }
            const u16vec2 row_idx = row_ids[col_i - ic * BN];
            const uint b_block_super = (row_idx.y * p.batch_stride_b + (row_idx.x % p.ne11) * p.stride_b) / QUANT_K_Q8_1 + 8u * superblock;
#else
            if (col_i >= p.N) {
                break;
            }
            const uint b_block_super = (batch_idx * p.batch_stride_b + col_i * p.stride_b) / QUANT_K_Q8_1 + 8u * superblock;
#endif
            sums[col] += dot_slice_q8_1(block_base, slice_in_super, b_block_super);
        }
    }
#else
    for (uint k = start_k; k < end_k; ++k) {
        const float a = decode_scalar(row_base_bytes, k);

        [[unroll]] for (uint col = 0u; col < BN; ++col) {
            const uint col_i = ic * BN + col;
#ifdef MUL_MAT_ID
            if (col_i >= _ne1) {
                break;
            }
            const u16vec2 row_idx = row_ids[col_i - ic * BN];
            const uint b_idx = row_idx.y * p.batch_stride_b + (row_idx.x % p.ne11) * p.stride_b + k;
#else
            if (col_i >= p.N) {
                break;
            }
            const uint b_idx = batch_idx * p.batch_stride_b + col_i * p.stride_b + k;
#endif
            sums[col] = fma(a, read_b_scalar(b_idx), sums[col]);
        }
    }
#endif

    [[unroll]] for (uint col = 0u; col < BN; ++col) {
        const uint col_i = ic * BN + col;
#ifdef MUL_MAT_ID
        if (col_i >= _ne1) {
            break;
        }
        const u16vec2 row_idx = row_ids[col_i - ic * BN];
        data_d[row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + dr] = D_TYPE(sums[col]);
#else
        if (col_i >= p.N) {
            break;
        }
        data_d[offsets + col_i * p.stride_d + dr] = D_TYPE(sums[col]);
#endif
    }
}