#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_EXT_shader_subgroup_extended_types_float16 : require
#extension GL_EXT_shader_subgroup_extended_types_int8 : require
#extension GL_EXT_shader_subgroup_extended_types_int16 : require

#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : enable

#ifndef MUL_MAT_ID_USE_SUBGROUPS
#define MUL_MAT_ID_USE_SUBGROUPS 1
#endif

#ifdef FLOAT16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

#ifdef MUL_MAT_ID
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif

#define IQK_MMQ_LUT

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#include "types.glsl"

layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
#if defined(A_TYPE_PACKED16)
layout (binding = 0) readonly buffer A_PACKED16 {A_TYPE_PACKED16 data_a_packed16[];};
#endif
#if defined(A_TYPE_PACKED32)
layout (binding = 0) readonly buffer A_PACKED32 {A_TYPE_PACKED32 data_a_packed32[];};
#endif
layout (binding = 1) readonly buffer B {block_q8_1_x4_packed128 data_b[];};
layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};

#ifdef MUL_MAT_ID
layout (binding = 3) readonly buffer IDS {int data_ids[];};
layout (binding = 4) readonly buffer RowMap {uint data_row_map[];};
#endif

layout (push_constant) uniform parameter
{
    uint M;
    uint N;
    uint K;
    uint stride_a;
    uint stride_b;
    uint stride_d;

    uint batch_stride_a;
    uint batch_stride_b;
    uint batch_stride_d;

#ifdef MUL_MAT_ID
    uint nei0;
    uint nei1;
    uint nbi1;
    uint ne11;
    uint n_experts;
    uint row_ids_offset;
#else
    uint base_work_group_z;
    uint num_batches;
    uint k_split;
    uint ne02;
    uint ne12;
    uint broadcast2;
    uint broadcast3;
#endif
} p;

layout (constant_id = 0) const uint BLOCK_SIZE = 512;
layout (constant_id = 1) const uint BM = 64;
layout (constant_id = 2) const uint BN = 64;
// layout (constant_id = 3) const uint BK = 32;
layout (constant_id = 4) const uint WM = 8;
layout (constant_id = 5) const uint WN = 16;
layout (constant_id = 6) const uint WMITER = 1;
layout (constant_id = 7) const uint TM = 8;
layout (constant_id = 8) const uint TN = 16;
layout (constant_id = 9) const uint TK = 32;  // Only needed for coopmat
layout (constant_id = 10) const uint WARP = 16;

#define BK 32

#define BK_STEP 8

#define I8AMat coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA>
#define I8BMat coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB>
#define I32AccMat coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>
#define F32AccMat coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>

// Each row contains 16 packed K16 chunks (one i32vec4 per 16 int8 values).
#define K16STRIDE 16

// Shared memory cache
shared i32vec4 buf_a_qs[BM * K16STRIDE]; // [K32 step][row][K16 half]
shared float buf_a_s[BM * K16STRIDE]; // [K16 chunk][row], including the block/row scale
shared i32vec4 buf_b_qs[BN * K16STRIDE]; // [column][K16 chunk]
shared float buf_b_d[BN * BK_STEP]; // [K32 step][column]
#ifndef DATA_A_IQK_ROW
shared int8_t buf_a_mask[TK]; // One K row, broadcast across TM rows
#endif

#define LOAD_VEC_B 16

#define NUM_WARPS (BLOCK_SIZE / WARP)

#include "mmq_iqk.glsl"
#include "mul_mm_id_funcs.glsl"

#ifdef DATA_A_IQK_ROW
void block_a_to_shmem(const uint16_t row_begin, const uint block_byte_offset, const float a_scale) {
#else
void block_a_to_shmem(const uint16_t row_begin, const uint ib_k, const float a_scale) {
#endif
    i32vec4 qs_a[4];
    i8vec4 a_scales;
    const uint16_t laneid = uint16_t(gl_SubgroupInvocationID);
    const uint16_t row = row_begin + (laneid & uint16_t(3));

#if defined(SG_A_SHAPE_16x4)
#ifdef DATA_A_IQK_ROW
    rm_prepare_a_k16x4_iter(block_byte_offset, qs_a, a_scales);
#else
    prepare_a_k16x4_iter(ib_k, qs_a, a_scales);
#endif
    const uint16_t subid = laneid >> uint16_t(2);
    const uint16_t is_high_16 = subid & uint16_t(1);
    const uint16_t cache_half = subid >> uint16_t(1);
    const uint16_t cache_base = cache_half * uint16_t(4);
    const uint qs_base = uint(cache_base) * 2u + uint(is_high_16);
    const uint a_qs_base = (uint(cache_base) * BM + row) * 2u + uint(is_high_16);

    buf_a_qs[a_qs_base + 0u * BM * 2u] = qs_a[0];
    buf_a_qs[a_qs_base + 1u * BM * 2u] = qs_a[1];
    buf_a_qs[a_qs_base + 2u * BM * 2u] = qs_a[2];
    buf_a_qs[a_qs_base + 3u * BM * 2u] = qs_a[3];
    buf_a_s[(qs_base + 0u) * BM + row] = float(a_scales[0]) * a_scale;
    buf_a_s[(qs_base + 2u) * BM + row] = float(a_scales[1]) * a_scale;
    buf_a_s[(qs_base + 4u) * BM + row] = float(a_scales[2]) * a_scale;
    buf_a_s[(qs_base + 6u) * BM + row] = float(a_scales[3]) * a_scale;
#elif defined(SG_A_SHAPE_32x2)
#ifdef DATA_A_IQK_ROW
    rm_prepare_a_k32x2_iter(block_byte_offset, qs_a, a_scales);
#else
    prepare_a_k32x2_iter(ib_k, qs_a, a_scales);
#endif
    const uint qs_base = uint(laneid >> uint16_t(2)) * 4u;
    const uint a_qs_base = (qs_base / 2u * BM + row) * 2u;

    buf_a_qs[a_qs_base + 0u] = qs_a[0];
    buf_a_qs[a_qs_base + 1u] = qs_a[1];
    buf_a_qs[a_qs_base + BM * 2u + 0u] = qs_a[2];
    buf_a_qs[a_qs_base + BM * 2u + 1u] = qs_a[3];
    buf_a_s[(qs_base + 0u) * BM + row] = float(a_scales[0]) * a_scale;
    buf_a_s[(qs_base + 1u) * BM + row] = float(a_scales[1]) * a_scale;
    buf_a_s[(qs_base + 2u) * BM + row] = float(a_scales[2]) * a_scale;
    buf_a_s[(qs_base + 3u) * BM + row] = float(a_scales[3]) * a_scale;
#else
#error "Unsupported IQK subgroup shape in block_a_to_shmem"
#endif
}

void block_b_to_shmem(const uint buf_ib, const uint ib, const uint iqs, const bool is_in_bounds) {
    const uint qs_base = (buf_ib % BN) * K16STRIDE + (buf_ib / BN) * (BK / 16);

    if (is_in_bounds) {
        const uint ib_outer = ib / 4;
        const uint ib_inner = ib % 4;

        if (iqs == 0) {
            buf_b_d[buf_ib] = float(data_b[ib_outer].ds[ib_inner].x);
        }
        buf_b_qs[qs_base + iqs] = data_b[ib_outer].qs[ib_inner * 2 + iqs];
    } else {
        if (iqs == 0) {
            buf_b_d[buf_ib] = 0.0f;
        }
        buf_b_qs[qs_base + iqs] = i32vec4(0);
    }
}

#ifdef DATA_A_IQK_ROW
void load_a(uint16_t sgid, uint32_t ir, uint32_t block, uint bytes_in_k, uint a_offset) {
#else
void load_a(uint16_t sgid, uint32_t ir, uint32_t block, uint blk256_in_k, uint a_ib_offset) {
#endif
    const uint16_t laneid = uint16_t(gl_SubgroupInvocationID);
    const uint16_t row_begin = sgid * uint16_t(4);
    const uint first_row = ir * BM + row_begin;
    const uint first_col = block;
    const uint16_t row = laneid & uint16_t(3);
#ifdef DATA_A_IQK_ROW
    const uint a_offset_in_row = IQK_ROW_META_SIZE + (first_col / QUANT_K) * IQK_BLOCK_SIZE;
    const uint a_row_begin = a_offset + (first_row + row) * bytes_in_k;
    const float a_scale = iqks_row_scale(a_row_begin);
    block_a_to_shmem(row_begin, a_row_begin + a_offset_in_row, a_scale);
#else
    const uint a_ib_row = a_ib_offset + first_row * blk256_in_k;
    const uint a_ib_k = a_ib_row + first_col / QUANT_K;
    const uint a_ib_lane = a_ib_k + row * blk256_in_k;
    const float a_scale = float(data_a[a_ib_lane].d);
    block_a_to_shmem(row_begin, a_ib_lane, a_scale);
#endif
}

void load_b(uint16_t sgid, uint16_t sgsize, uint32_t pos_b_ib) {
    const uint16_t laneid = uint16_t(gl_SubgroupInvocationID);
    const uint16_t k_step = laneid / uint16_t(BK / LOAD_VEC_B);
    const uint16_t iqs = laneid % uint16_t(BK / LOAD_VEC_B);

    [[unroll]] for (uint buf_ib = sgid; buf_ib < BN; buf_ib += sgsize) {
        uint ib = pos_b_ib;
#ifdef MUL_MAT_ID
        const bool n_in_bounds = buf_ib < _ne1;
        if (n_in_bounds) {
            const u16vec2 row_idx = row_ids[buf_ib];
            ib += row_idx.y * p.batch_stride_b / BK + (row_idx.x % p.ne11) * p.stride_b / BK;
        }
#else
        const bool n_in_bounds = gl_WorkGroupID.y * BN + buf_ib < p.N;
        ib += buf_ib * p.stride_b / BK;
#endif
        block_b_to_shmem(k_step * BN + buf_ib, ib + k_step, iqs, n_in_bounds);
    }
}


void main() {
#ifdef MUL_MAT_ID
    const uint tile_idx = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    if (tile_idx >= data_row_map[0]) {
        return;
    }
    const uint expert_idx = data_row_map[1 + 2 * tile_idx];
    const uint row_begin = tile_idx * BN;
    _ne1 = data_row_map[2 + 2 * tile_idx];
    const uint ic = 0;
#else
    const uint ic = gl_WorkGroupID.y;
#endif

#ifndef DATA_A_IQK_ROW
    // Each subgroup initializes the full mask before table initialization.
    [[unroll]] for (uint k = gl_SubgroupInvocationID; k < TK; k += WARP) {
        buf_a_mask[k] = int8_t(k < TK / 2 ? 1 : 0);
    }
#endif

#if defined(DATA_A_IQ2_K) || defined(DATA_A_IQ2_KS)
    init_iq2k_table();
#elif defined(DATA_A_IQ2_KL)
    init_iq2kl_table();
#elif defined(DATA_A_IQ3_K) || defined(DATA_A_IQ3_KS)
    init_iq3k_table();
#elif defined(DATA_A_IQ4_K) || defined(DATA_A_IQ4_KSS) || defined(DATA_A_IQ4_KS)
    init_iq4k_table();
#elif defined(DATA_A_IQ5_K) || defined(DATA_A_IQ5_KS)
    init_iq5k_table();
#elif defined(NEEDS_INIT_IQ_SHMEM)
    init_iq_shmem(gl_WorkGroupSize);
#endif

#ifndef MUL_MAT_ID
    const uint batch_idx = gl_WorkGroupID.z + p.base_work_group_z;

    const uint i13 = batch_idx / p.ne12;
    const uint i12 = batch_idx % p.ne12;

    const uint i03 = i13 / p.broadcast3;
    const uint i02 = i12 / p.broadcast2;

    const uint batch_idx_a = i03 * p.ne02 + i02;
#endif

    const uint blocks_m = (p.M + BM - 1) / BM;
    const uint ir = gl_WorkGroupID.x % blocks_m;
    const uint ik = gl_WorkGroupID.x / blocks_m;

    const uint WNITER = (WM * WN) / (TM * TN * WMITER);
    const uint WSUBM = WM / WMITER;
    const uint WSUBN = WN / WNITER;
    const uint16_t subgroup_id = uint16_t(gl_SubgroupID);
    const uint16_t laneid = uint16_t(gl_SubgroupInvocationID);
    const uint16_t subgroup_count = uint16_t(BLOCK_SIZE / WARP);
    const uint16_t load_a_count = uint16_t(BM / 4);

    // Logical coordinates in the staged output, not the fragment's lane layout.
    const uint16_t tiwr = laneid % uint16_t(TM);
    const uint16_t tiwc = laneid / uint16_t(TM);

    const uint16_t warp_r = subgroup_id % uint16_t(BM / WM);
    const uint16_t warp_c = subgroup_id / uint16_t(BM / WM);

#ifdef MUL_MAT_ID
    load_row_ids(row_begin);
#endif

#ifdef MUL_MAT_ID
    const uint start_k = 0;
    const uint end_k = p.K;
#else
    const uint start_k = ik * p.k_split;
    const uint end_k = min(p.K, (ik + 1) * p.k_split);
#endif

#ifdef MUL_MAT_ID
    uint pos_b_ib = 0;
#else
    uint pos_b_ib = (batch_idx * p.batch_stride_b + ic * BN * p.stride_b + start_k) / BK;
#endif

    F32AccMat sums[WMITER * WNITER];

    [[unroll]] for (uint i = 0; i < WMITER * WNITER; i++) {
        sums[i] = F32AccMat(0.0f);
    }

    const uint a_offset =
#ifdef MUL_MAT_ID
    expert_idx * p.batch_stride_a;
#else
    batch_idx_a * p.batch_stride_a;
#endif
#ifdef DATA_A_IQK_ROW
    const uint bytes_in_k = IQK_ROW_META_SIZE + (p.K / QUANT_K) * IQK_BLOCK_SIZE;
#else
    const uint blk256_in_k = p.K / QUANT_K;
    const uint a_ib_offset = a_offset / QUANT_K;
#endif

#ifndef DATA_A_IQK_ROW
    I8AMat mask;
    // Row-major stride=0 repeats the same 1xTK row across the A fragment.
    coopMatLoad(mask, buf_a_mask, 0, 0, gl_CooperativeMatrixLayoutRowMajor);
#endif

    for (uint block = start_k; block < end_k; block += BK * BK_STEP) {

        if (load_a_count == subgroup_count) {
#ifdef DATA_A_IQK_ROW
            load_a(subgroup_id, ir, block, bytes_in_k, a_offset);
#else
            load_a(subgroup_id, ir, block, blk256_in_k, a_ib_offset);
#endif
            load_b(subgroup_id, subgroup_count, pos_b_ib);
        } else {
            if (subgroup_id < load_a_count) {
#ifdef DATA_A_IQK_ROW
                load_a(subgroup_id, ir, block, bytes_in_k, a_offset);
#else
                load_a(subgroup_id, ir, block, blk256_in_k, a_ib_offset);
#endif
            } else {
                load_b(subgroup_id - load_a_count, subgroup_count - load_a_count, pos_b_ib);
            }
        }

        barrier();

        pos_b_ib += BK_STEP;

        [[unroll]] for (uint k_step = 0; k_step < BK_STEP; k_step++) {
            const uint qs_base = k_step * (TK / 16);

            [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
                const uint b_col = warp_c * WN + wsic * WSUBN;
                I8BMat qs_b;
                F32AccMat scales_b;
                coopMatLoad(qs_b, buf_b_qs, b_col * K16STRIDE + qs_base,
                            K16STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
                // Repeat the TN column scales across all TM rows.
                coopMatLoad(scales_b, buf_b_d, k_step * BN + b_col,
                            0, gl_CooperativeMatrixLayoutRowMajor);

                [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                    const uint a_row = warp_r * WM + wsir * WSUBM;
                    const uint sums_idx = wsic * WMITER + wsir;
                    I8AMat qs_a;
                    F32AccMat scales_lo;
                    coopMatLoad(qs_a, buf_a_qs, (k_step * BM + a_row) * 2u,
                                2, gl_CooperativeMatrixLayoutRowMajor);
                    // Repeat the TM row scales across all TN columns.
                    coopMatLoad(scales_lo, buf_a_s, qs_base * BM + a_row,
                                0, gl_CooperativeMatrixLayoutColumnMajor);

#ifdef DATA_A_IQK_ROW
                    const I32AccMat acc_lo = coopMatMulAdd(qs_a, qs_b, I32AccMat(0));
                    const F32AccMat sum_lo = F32AccMat(acc_lo) * scales_lo;

                    sums[sums_idx] += sum_lo * scales_b;
#else
                    F32AccMat scales_hi;
                    coopMatLoad(scales_hi, buf_a_s, (qs_base + 1u) * BM + a_row,
                                0, gl_CooperativeMatrixLayoutColumnMajor);

                    const I8AMat qs_lo = qs_a * mask;
                    const I8AMat qs_hi = qs_a - qs_lo;
                    const I32AccMat acc_lo = coopMatMulAdd(qs_lo, qs_b, I32AccMat(0));
                    const I32AccMat acc_hi = coopMatMulAdd(qs_hi, qs_b, I32AccMat(0));
                    const F32AccMat sum_lo = F32AccMat(acc_lo) * scales_lo;
                    const F32AccMat sum_hi = F32AccMat(acc_hi) * scales_hi;

                    sums[sums_idx] += (sum_lo + sum_hi) * scales_b;
#endif
                }
            }
        }

        barrier();
    }

    const uint dr = ir * BM + warp_r * WM;
    const uint dc = ic * BN + warp_c * WN;

#ifndef MUL_MAT_ID
    const uint offsets = batch_idx * p.batch_stride_d + ik * p.batch_stride_d * p.num_batches;
#endif

    // A is no longer needed. Reuse its packed storage for float output bits.
    // For the supported BN <= 64 tiles, BM * K16STRIDE i32vec4 values fit BM * BN floats.
    const uint stage_base = uint(subgroup_id) * (TM * TN / 4);

    [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
        [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
            const uint sums_idx = wsic * WMITER + wsir;
            coopMatStore(sums[sums_idx], buf_a_qs, stage_base, TM / 4,
                         gl_CooperativeMatrixLayoutColumnMajor);
            controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);

            const uint dr_warp = dr + wsir * WSUBM + tiwr;
            const uint dc_warp = dc + wsic * WSUBN + tiwc;
            [[unroll]] for (uint cc = 0; cc < TN; cc += WARP / TM) {
#ifdef MUL_MAT_ID
                const uint row_i = dc_warp + cc;
                if (row_i >= _ne1) break;

                const u16vec2 row_idx = row_ids[row_i - ic * BN];
#endif // MUL_MAT_ID
                const uint stage_idx = (cc + uint(tiwc)) * TM + uint(tiwr);
                const float value = intBitsToFloat(buf_a_qs[stage_base + stage_idx / 4][stage_idx % 4]);
#ifdef MUL_MAT_ID
                if (dr_warp < p.M) {
                    data_d[row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + dr_warp] = D_TYPE(value);
                }
#else
                if (dr_warp < p.M && dc_warp + cc < p.N) {
                    data_d[offsets + (dc_warp + cc) * p.stride_d + dr_warp] = D_TYPE(value);
                }
#endif // MUL_MAT_ID
            }
            controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
        }
    }
}
