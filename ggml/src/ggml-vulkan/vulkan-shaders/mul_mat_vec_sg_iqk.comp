#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#define MMQ
#define SG_IQK 1
#define B_TYPE block_q8_1_x4

#include "mul_mat_vec_base.glsl"

#ifndef SUBGROUP_SIZE
#error SUBGROUP_SIZE must be defined
#endif

#define K_PER_ITER 32
#define SG_K (QUANT_K / SUBGROUP_SIZE)
#define SG_K_PER_ITER (K_PER_ITER / SG_K)
#define SG_QS_PER_ITER (SG_K / 4)
#define WG_K_PER_ITER (SG_K_PER_ITER * QUANT_K)

#if (SUBGROUP_SIZE == 0) || ((QUANT_K % SUBGROUP_SIZE) != 0) || (SG_K < 4) || ((K_PER_ITER % SG_K) != 0)
#error unsupported subgroup size
#endif


layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#include "mmq_iqk.glsl"


uint a_offset, b_offset, d_offset;

void iter_tail(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint subgroup_col) {
    int32_t qs_a[SG_QS_PER_ITER];
    float a_scale;
    const uint lane_col = gl_SubgroupInvocationID * SG_K;
    const uint a_row_offset = first_row * p.ncols;
    const uint a_ib_sg = (a_row_offset + subgroup_col) / QUANT_K + a_offset / 8u;

    prepare_a_sg(a_ib_sg, qs_a, a_scale);

    const uint b_block_col0_sg = subgroup_col / (QUANT_K_Q8_1 * 4) + b_offset / 4;
    const uint batch_block_b = p.batch_stride_b / (QUANT_K_Q8_1 * 4);
    const uint b_block_adj = lane_col / (QUANT_K_Q8_1 * 4);
    const uint b_block_inner = (lane_col / QUANT_K_Q8_1) % 4;
    const uint b_qs_idx = (lane_col % QUANT_K_Q8_1) / 4;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        int32_t cache_b_qs[SG_QS_PER_ITER];
        const uint b_block_outer = b_block_col0_sg + j * batch_block_b + b_block_adj;
        const vec2 cache_b_ds = vec2(data_b[b_block_outer].ds[b_block_inner]);

        [[unroll]] for (uint q = 0; q < SG_QS_PER_ITER; ++q) {
            cache_b_qs[q] = data_b[b_block_outer].qs[b_block_inner * 8 + b_qs_idx + q];
        }

        int32_t q_sum = 0;
        [[unroll]] for (uint q = 0; q < SG_QS_PER_ITER; ++q) {
            q_sum += dotPacked4x8EXT(qs_a[q], cache_b_qs[q]);
        }
        temp[j][0] += FLOAT_TYPE(float(cache_b_ds.x) * a_scale * float(q_sum));
    }
}

void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint subgroup_col) {
    int32_t qs_a[K_PER_ITER / 4];
    float a_scales[SG_K_PER_ITER];
    const uint lane_col = gl_SubgroupInvocationID * SG_K;
    const uint a_row_offset = first_row * p.ncols;
    const uint a_ib_sg = (a_row_offset + subgroup_col) / QUANT_K + a_offset / 8u;

    [[unroll]] for (uint sg_iter = 0; sg_iter < SG_K_PER_ITER; ++sg_iter) {
        int32_t qs_a_sg[SG_QS_PER_ITER];
        prepare_a_sg(a_ib_sg + sg_iter, qs_a_sg, a_scales[sg_iter]);
        [[unroll]] for (uint q = 0; q < SG_QS_PER_ITER; ++q) {
            qs_a[sg_iter * SG_QS_PER_ITER + q] = qs_a_sg[q];
        }
    }

    const uint b_block_col0_sg = subgroup_col / (QUANT_K_Q8_1 * 4) + b_offset / 4;
    const uint batch_block_b = p.batch_stride_b / (QUANT_K_Q8_1 * 4);
    const uint b_block_adj = lane_col / (QUANT_K_Q8_1 * 4);
    const uint b_block_inner = (lane_col / QUANT_K_Q8_1) % 4;
    const uint b_qs_idx = (lane_col % QUANT_K_Q8_1) / 4;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        int32_t cache_b_qs[K_PER_ITER / 4];
        vec2 cache_b_ds;

        uint b_block_sg = b_block_col0_sg + j * batch_block_b;

        [[unroll]] for (uint sg_iter = 0; sg_iter < SG_K_PER_ITER; ++sg_iter) {
            const uint b_block_outer = b_block_sg + b_block_adj;
            cache_b_ds = vec2(data_b[b_block_outer].ds[b_block_inner]);

            [[unroll]] for (uint q = 0; q < SG_QS_PER_ITER; ++q) {
                const uint q_idx = sg_iter * SG_QS_PER_ITER + q;
                cache_b_qs[q_idx] = data_b[b_block_outer].qs[b_block_inner * 8 + b_qs_idx + q];
            }

            int32_t q_sum = 0;
            [[unroll]] for (uint q = 0; q < SG_QS_PER_ITER; ++q) {
                const uint q_idx = sg_iter * SG_QS_PER_ITER + q;
                q_sum += dotPacked4x8EXT(qs_a[q_idx], cache_b_qs[q_idx]);
            }
            temp[j][0] += FLOAT_TYPE(float(cache_b_ds.x) * a_scales[sg_iter] * float(q_sum));
            b_block_sg += QUANT_K / (QUANT_K_Q8_1 * 4);
        }
    }
}

void compute_outputs(const uint32_t first_row) {
    const uint tid = gl_LocalInvocationID.x;
    const uint subgroup_id = gl_SubgroupID;

    get_offsets(a_offset, b_offset, d_offset);
    a_offset *= QUANT_K / QUANT_K_Q8_1;
    b_offset /= QUANT_K_Q8_1;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        temp[j][0] = FLOAT_TYPE(0.0f);
    }

    uint subgroup_col = subgroup_id * WG_K_PER_ITER;
    const uint col_stride = K_PER_ITER * gl_WorkGroupSize.x;
    uint num_iters = p.ncols / col_stride;
    if (num_iters * col_stride + (subgroup_id + 1u) * WG_K_PER_ITER <= p.ncols) {
        num_iters++;
    }

    while (num_iters >= 4) {
        // Manually partially unroll the loop
        [[unroll]] for (uint k = 0; k < 4; ++k) {
            iter(temp, first_row, subgroup_col);
            subgroup_col += col_stride;
        }

        num_iters -= 4;
    }

    if (num_iters >= 2) {
        // Manually partially unroll the loop
        iter(temp, first_row, subgroup_col);
        subgroup_col += col_stride;
        iter(temp, first_row, subgroup_col);
        subgroup_col += col_stride;
        num_iters -= 2;
    }

    if (num_iters > 0) {
        iter(temp, first_row, subgroup_col);
        subgroup_col += col_stride;
    }

    if (subgroup_col < p.ncols) {
        const uint num_tail_blocks = (p.ncols - subgroup_col + QUANT_K - 1u) / QUANT_K;
        [[unroll]] for (uint tail_block = 0; tail_block < num_tail_blocks; ++tail_block) {
            iter_tail(temp, first_row, subgroup_col + tail_block * QUANT_K);
        }
    }

    reduce_result(temp, d_offset, first_row, 1, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

#if defined(NEEDS_INIT_IQ_SHMEM) && !defined(DATA_A_IQ2_K) && !defined(DATA_A_IQ2_KS) && !defined(DATA_A_IQ2_KL) && !defined(DATA_A_IQ3_K) && !defined(DATA_A_IQ3_KS)
    init_iq_shmem(gl_WorkGroupSize);
#endif
#if defined(DATA_A_IQ2_K) || defined(DATA_A_IQ2_KS)
    init_iq2k_table();
#elif defined(DATA_A_IQ2_KL)
    init_iq2kl_table();
#elif defined(DATA_A_IQ3_K) || defined(DATA_A_IQ3_KS)
    init_iq3k_table();
#endif

    if (first_row >= p.stride_d) {
        return;
    }
    compute_outputs(first_row);
}