#if defined(DATA_A_IQ4_KS)
const uint IQKS_SUPERBLOCK_BYTES = 136u;
const uint IQKS_ROW_PREFIX_BYTES = 4u;
#elif defined(DATA_A_IQ4_KSS)
const uint IQKS_SUPERBLOCK_BYTES = 128u;
const uint IQKS_ROW_PREFIX_BYTES = 4u;
#elif defined(DATA_A_IQ5_KS)
const uint IQKS_SUPERBLOCK_BYTES = 168u;
const uint IQKS_ROW_PREFIX_BYTES = 4u;
#elif defined(DATA_A_IQ2_KS)
const uint IQKS_SUPERBLOCK_BYTES = 70u;
const uint IQKS_ROW_PREFIX_BYTES = 2u;
#elif defined(DATA_A_IQ3_KS)
const uint IQKS_SUPERBLOCK_BYTES = 102u;
const uint IQKS_ROW_PREFIX_BYTES = 2u;
#elif defined(DATA_A_IQ2_KL)
const uint IQKS_SUPERBLOCK_BYTES = 86u;
const uint IQKS_ROW_PREFIX_BYTES = 2u;
#else
#error unsupported IQKS type
#endif

uint get_a_byte(const uint byte_offset) {
    return (data_a_packed32[byte_offset >> 2u] >> (8u * (byte_offset & 3u))) & 0xffu;
}

uint get_a_u16(const uint byte_offset) {
    const uint word = data_a_packed32[byte_offset >> 2u];
    const uint shift = 8u * (byte_offset & 3u);
    if ((byte_offset & 3u) <= 2u) {
        return (word >> shift) & 0xffffu;
    }
    return ((word >> 24u) & 0xffu) | ((data_a_packed32[(byte_offset >> 2u) + 1u] & 0xffu) << 8u);
}

uint get_a_u32(const uint byte_offset) {
    if ((byte_offset & 3u) == 0u) {
        return data_a_packed32[byte_offset >> 2u];
    }
    const uint w0 = data_a_packed32[byte_offset >> 2u];
    const uint w1 = data_a_packed32[(byte_offset >> 2u) + 1u];
    const uint shift = 8u * (byte_offset & 3u);
    return (w0 >> shift) | (w1 << (32u - shift));
}

int32_t pack_i8_4(const int v0, const int v1, const int v2, const int v3) {
    return int32_t(pack32(i8vec4(int8_t(v0), int8_t(v1), int8_t(v2), int8_t(v3))));
}

#ifdef B_IS_Q8_1
int32_t q8_word(const uint q8_block_idx, const uint word_idx) {
    const uint b_outer = q8_block_idx / 4u;
    const uint b_inner = q8_block_idx % 4u;
    return data_b[b_outer].qs[8u * b_inner + word_idx];
}

float q8_scale(const uint q8_block_idx) {
    const uint b_outer = q8_block_idx / 4u;
    const uint b_inner = q8_block_idx % 4u;
    return vec2(data_b[b_outer].ds[b_inner]).x;
}

float dot_q8_1_block(const uint row_base_bytes, const uint block32, const uint q8_block_idx) {
    const uint superblock = block32 / 8u;
    const uint ib32 = block32 % 8u;

#if defined(DATA_A_IQ4_KS)
    const float d = uintBitsToFloat(get_a_u32(row_base_bytes));
    const uint block_base = row_base_bytes + IQKS_ROW_PREFIX_BYTES + superblock * IQKS_SUPERBLOCK_BYTES;
    const uint scale = get_a_byte(block_base + ib32);
    const float dl = d * float(int(scale & 0xfeu) - 127);
    const uint values_offset = (scale & 1u) << 4u;
    const uint qs_base = block_base + 8u + 16u * ib32;
    int32_t q_sum = 0;
    [[unroll]] for (uint w = 0u; w < 4u; ++w) {
        const uint qw = get_a_u32(qs_base + 4u * w);
        const int32_t lo = pack_i8_4(
            int(kvalues_iq4k_const[values_offset + ((qw >> 0u) & 0xfu)]),
            int(kvalues_iq4k_const[values_offset + ((qw >> 8u) & 0xfu)]),
            int(kvalues_iq4k_const[values_offset + ((qw >> 16u) & 0xfu)]),
            int(kvalues_iq4k_const[values_offset + ((qw >> 24u) & 0xfu)]));
        const int32_t hi = pack_i8_4(
            int(kvalues_iq4k_const[values_offset + ((qw >> 4u) & 0xfu)]),
            int(kvalues_iq4k_const[values_offset + ((qw >> 12u) & 0xfu)]),
            int(kvalues_iq4k_const[values_offset + ((qw >> 20u) & 0xfu)]),
            int(kvalues_iq4k_const[values_offset + ((qw >> 28u) & 0xfu)]));
        q_sum += dotPacked4x8EXT(lo, q8_word(q8_block_idx, w + 0u));
        q_sum += dotPacked4x8EXT(hi, q8_word(q8_block_idx, w + 4u));
    }
    return dl * q8_scale(q8_block_idx) * float(q_sum);
#elif defined(DATA_A_IQ4_KSS)
    const float d = uintBitsToFloat(get_a_u32(row_base_bytes));
    const uint block_base = row_base_bytes + IQKS_ROW_PREFIX_BYTES + superblock * IQKS_SUPERBLOCK_BYTES + 16u * ib32;
    const uint w0 = get_a_u32(block_base + 0u);
    const uint w1 = get_a_u32(block_base + 4u);
    const uint w2 = get_a_u32(block_base + 8u);
    const uint w3 = get_a_u32(block_base + 12u);
    const uint s32 = (w0 & 0x00010001u) | ((w1 & 0x00010001u) << 2u) | ((w2 & 0x00010001u) << 4u) | ((w3 & 0x00010001u) << 6u);
    const uint ls = (s32 | (s32 >> 15u)) & 0xffu;
    const float dl = d * float(int(ls & 0xfeu) - 127);
    const uint values_offset = (ls & 1u) << 4u;
    int32_t q_sum = 0;
    [[unroll]] for (uint w = 0u; w < 4u; ++w) {
        uint qw = get_a_u32(block_base + 4u * w) & 0xfffefffeu;
        qw ^= qw >> 1u;
        const int32_t lo = pack_i8_4(
            int(kvalues_iq4k_const[values_offset + ((qw >> 0u) & 0xfu)]),
            int(kvalues_iq4k_const[values_offset + ((qw >> 8u) & 0xfu)]),
            int(kvalues_iq4k_const[values_offset + ((qw >> 16u) & 0xfu)]),
            int(kvalues_iq4k_const[values_offset + ((qw >> 24u) & 0xfu)]));
        const int32_t hi = pack_i8_4(
            int(kvalues_iq4k_const[values_offset + ((qw >> 4u) & 0xfu)]),
            int(kvalues_iq4k_const[values_offset + ((qw >> 12u) & 0xfu)]),
            int(kvalues_iq4k_const[values_offset + ((qw >> 20u) & 0xfu)]),
            int(kvalues_iq4k_const[values_offset + ((qw >> 28u) & 0xfu)]));
        q_sum += dotPacked4x8EXT(lo, q8_word(q8_block_idx, w + 0u));
        q_sum += dotPacked4x8EXT(hi, q8_word(q8_block_idx, w + 4u));
    }
    return dl * q8_scale(q8_block_idx) * float(q_sum);
#elif defined(DATA_A_IQ5_KS)
    const float d = uintBitsToFloat(get_a_u32(row_base_bytes));
    const uint block_base = row_base_bytes + IQKS_ROW_PREFIX_BYTES + superblock * IQKS_SUPERBLOCK_BYTES;
    const uint ib64 = ib32 / 2u;
    const uint ihalf = ib32 & 1u;
    const uint scale = get_a_byte(block_base + 2u * ib64 + ihalf);
    const float dl = d * float(int(scale & 0xfeu) - 127);
    const uint values_offset = (scale & 1u) << 5u;
    const uint qs_base = block_base + 8u + 32u * ib64;
    const uint qh_base = block_base + 136u;
    const uint qh_shift = 2u * ib64 + ihalf;
    int32_t q_sum = 0;
    [[unroll]] for (uint w = 0u; w < 8u; ++w) {
        const uint qs_word = get_a_u32(qs_base + 4u * w);
        const uint qh_word = get_a_u32(qh_base + 4u * w);
        const uint nibbles = ihalf == 0u ? (qs_word & 0x0f0f0f0fu) : ((qs_word >> 4u) & 0x0f0f0f0fu);
        const uint indices = nibbles | (((qh_word >> qh_shift) & 0x01010101u) << 4u);
        const int32_t packed = pack_i8_4(
            int(kvalues_iq5nl_const[values_offset + (indices & 0x1fu)]),
            int(kvalues_iq5nl_const[values_offset + ((indices >> 8u) & 0x1fu)]),
            int(kvalues_iq5nl_const[values_offset + ((indices >> 16u) & 0x1fu)]),
            int(kvalues_iq5nl_const[values_offset + ((indices >> 24u) & 0x1fu)]));
        q_sum += dotPacked4x8EXT(packed, q8_word(q8_block_idx, w));
    }
    return dl * q8_scale(q8_block_idx) * float(q_sum);
#elif defined(DATA_A_IQ2_KS)
    const float d = unpackHalf2x16(get_a_u16(row_base_bytes)).x;
    const uint block_base = row_base_bytes + IQKS_ROW_PREFIX_BYTES + superblock * IQKS_SUPERBLOCK_BYTES;
    const uint ib128 = ib32 / 4u;
    const uint group = ib32 & 3u;
    const uint bit_shift = 2u * group;
    const uint extra_shifted = get_a_u16(block_base) >> (4u * ib128);
    const uint table_offset = ((extra_shifted >> group) & 1u) * 4u;
    const uint scale_byte = get_a_byte(block_base + 2u + 2u * ib128 + group / 2u);
    const uint scale_nibble = (group & 1u) == 0u ? (scale_byte & 0xfu) : ((scale_byte >> 4u) & 0xfu);
    const float dl = d * float(int(scale_nibble | (((extra_shifted >> (8u + group)) & 1u) << 4u)) - 16);
    const uint qs_base = block_base + 6u + 32u * ib128;
    int32_t q_sum = 0;
    [[unroll]] for (uint w = 0u; w < 8u; ++w) {
        const uint qs_word = get_a_u32(qs_base + 4u * w);
        const uint indices = (qs_word >> bit_shift) & 0x03030303u;
        const int32_t packed = pack_i8_4(
            int(kvalues_iq2nl_const[table_offset + (indices & 0x3u)]),
            int(kvalues_iq2nl_const[table_offset + ((indices >> 8u) & 0x3u)]),
            int(kvalues_iq2nl_const[table_offset + ((indices >> 16u) & 0x3u)]),
            int(kvalues_iq2nl_const[table_offset + ((indices >> 24u) & 0x3u)]));
        q_sum += dotPacked4x8EXT(packed, q8_word(q8_block_idx, w));
    }
    return dl * q8_scale(q8_block_idx) * float(q_sum);
#elif defined(DATA_A_IQ3_KS)
    const float d = unpackHalf2x16(get_a_u16(row_base_bytes)).x;
    const uint block_base = row_base_bytes + IQKS_ROW_PREFIX_BYTES + superblock * IQKS_SUPERBLOCK_BYTES;
    const uint ib128 = ib32 / 4u;
    const uint group = ib32 & 3u;
    const uint bit_shift = 2u * group;
    const uint extra_shifted = get_a_u16(block_base) >> (4u * ib128);
    const uint table_offset = (((extra_shifted >> 8u) >> group) & 1u) * 8u;
    const uint scale_byte = get_a_byte(block_base + 2u + group);
    const uint scale_nibble = (scale_byte >> (4u * ib128)) & 0xfu;
    const float dl = d * float(int(scale_nibble | (((extra_shifted >> group) & 1u) << 4u)) - 16);
    const uint qs_base = block_base + 6u + 32u * ib128;
    const uint qh_base = block_base + 70u;
    const uint qh_bit_pos = 4u * ib128 + group;
    int32_t q_sum = 0;
    [[unroll]] for (uint w = 0u; w < 8u; ++w) {
        const uint qs_word = get_a_u32(qs_base + 4u * w);
        const uint qh_word = get_a_u32(qh_base + 4u * w);
        const uint indices = ((qs_word >> bit_shift) & 0x03030303u) | (((qh_word >> qh_bit_pos) & 0x01010101u) << 2u);
        const int32_t packed = pack_i8_4(
            int(kvalues_iq3nl_const[table_offset + (indices & 0x7u)]),
            int(kvalues_iq3nl_const[table_offset + ((indices >> 8u) & 0x7u)]),
            int(kvalues_iq3nl_const[table_offset + ((indices >> 16u) & 0x7u)]),
            int(kvalues_iq3nl_const[table_offset + ((indices >> 24u) & 0x7u)]));
        q_sum += dotPacked4x8EXT(packed, q8_word(q8_block_idx, w));
    }
    return dl * q8_scale(q8_block_idx) * float(q_sum);
#elif defined(DATA_A_IQ2_KL)
    const float d = unpackHalf2x16(get_a_u16(row_base_bytes)).x;
    const uint block_base = row_base_bytes + IQKS_ROW_PREFIX_BYTES + superblock * IQKS_SUPERBLOCK_BYTES;
    const uint ib64 = ib32 / 2u;
    const uint ihalf = ib32 & 1u;
    const uint sh = get_a_u16(block_base) >> (4u * ib64);
    const uint sl0 = (get_a_byte(block_base + 2u + ((2u * ib64) % 4u)) >> (4u * (ib64 / 2u))) & 0xfu;
    const uint sl1 = (get_a_byte(block_base + 2u + ((2u * ib64 + 1u) % 4u)) >> (4u * (ib64 / 2u))) & 0xfu;
    const float dl = d * float(ihalf == 0u ? int(sl0 | ((sh << 4u) & 0x30u)) - 32 : int(sl1 | ((sh << 2u) & 0x30u)) - 32);
    const uint qs_base = block_base + 6u + 16u * ib64;
    const uint qh_base = block_base + 70u;
    const uint qh_shift = 2u * ib64;
    int32_t q_sum = 0;
    [[unroll]] for (uint w = 0u; w < 4u; ++w) {
        const uint qs_word = get_a_u32(qs_base + 4u * w);
        const uint qh_word = get_a_u32(qh_base + 4u * w) >> qh_shift;
        const uint idx_packed = ihalf == 0u ? ((qs_word & 0x0f0f0f0fu) | ((qh_word << 4u) & 0x10101010u)) : (((qs_word >> 4u) & 0x0f0f0f0fu) | ((qh_word << 3u) & 0x10101010u));
        const uint idx0 = idx_packed & 0x1fu;
        const uint idx1 = (idx_packed >> 8u) & 0x1fu;
        const uint idx2 = (idx_packed >> 16u) & 0x1fu;
        const uint idx3 = (idx_packed >> 24u) & 0x1fu;
        const int32_t v1 = int32_t(kvalues_iq2kl_const[idx0] | (kvalues_iq2kl_const[idx1] << 16u));
        const int32_t v2 = int32_t(kvalues_iq2kl_const[idx2] | (kvalues_iq2kl_const[idx3] << 16u));
        q_sum += dotPacked4x8EXT(v1, q8_word(q8_block_idx, 2u * w + 0u));
        q_sum += dotPacked4x8EXT(v2, q8_word(q8_block_idx, 2u * w + 1u));
    }
    return dl * q8_scale(q8_block_idx) * float(q_sum);
#else
#error unsupported IQKS type
#endif
}
