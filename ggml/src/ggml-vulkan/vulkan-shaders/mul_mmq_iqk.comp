#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_EXT_shader_subgroup_extended_types_float16 : require
#extension GL_EXT_shader_subgroup_extended_types_int8 : require
#extension GL_EXT_shader_subgroup_extended_types_int16 : require

#extension GL_EXT_integer_dot_product : require

#ifndef MUL_MAT_ID_USE_SUBGROUPS
#define MUL_MAT_ID_USE_SUBGROUPS 1
#endif

#ifdef FLOAT16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

#ifdef MUL_MAT_ID
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif

#define IQK_MMQ_LUT

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#include "types.glsl"

layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
#if defined(A_TYPE_PACKED16)
layout (binding = 0) readonly buffer A_PACKED16 {A_TYPE_PACKED16 data_a_packed16[];};
#endif
#if defined(A_TYPE_PACKED32)
layout (binding = 0) readonly buffer A_PACKED32 {A_TYPE_PACKED32 data_a_packed32[];};
#endif
layout (binding = 1) readonly buffer B {block_q8_1_x4_packed128 data_b[];};
layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};

#ifdef MUL_MAT_ID
layout (binding = 3) readonly buffer IDS {int data_ids[];};
layout (binding = 4) readonly buffer Counts {int data_expert_count[];};
#endif

layout (push_constant) uniform parameter
{
    uint M;
    uint N;
    uint K;
    uint stride_a;
    uint stride_b;
    uint stride_d;

    uint batch_stride_a;
    uint batch_stride_b;
    uint batch_stride_d;

#ifdef MUL_MAT_ID
    uint nei0;
    uint nei1;
    uint nbi1;
    uint ne11;
    uint n_experts;
    uint hoist_row_ids;
#else
    uint base_work_group_z;
    uint num_batches;
    uint k_split;
    uint ne02;
    uint ne12;
    uint broadcast2;
    uint broadcast3;
#endif
} p;

layout (constant_id = 0) const uint BLOCK_SIZE = 64;
layout (constant_id = 1) const uint BM = 64;
layout (constant_id = 2) const uint BN = 64;
// layout (constant_id = 3) const uint BK = 32;
layout (constant_id = 4) const uint WM = 32;
layout (constant_id = 5) const uint WN = 32;
layout (constant_id = 6) const uint WMITER = 2;
layout (constant_id = 7) const uint TM = 4;
layout (constant_id = 8) const uint TN = 2;
layout (constant_id = 9) const uint TK = 1;  // Only needed for coopmat
layout (constant_id = 10) const uint WARP = 32;

#define BK 32

#define BK_STEP 8

#include "mul_mmq_shmem_types.glsl"

// Shared memory cache
shared i32vec4 buf_a_qs[BM][16]; // BM * 256
shared int8_t buf_a_s[BM][16]; // BM * 16
shared block_b_cache buf_b[BN * BK_STEP];
// Register cache
i32vec4 cache_a_qs[2];
int16_t cache_a_s[2];
block_b_cache cache_b;

#define LOAD_VEC_B 16

#define NUM_WARPS (BLOCK_SIZE / WARP)

#include "mmq_iqk.glsl"
#include "mul_mm_id_funcs.glsl"
#include "mul_mmq_funcs.glsl"

#ifdef DATA_A_IQK_ROW
void block_a_to_shmem(const uint16_t row_begin, const uint block_byte_offset) {
#else
void block_a_to_shmem(const uint16_t row_begin, const uint ib_k) {
#endif
    i32vec4 qs_a[4];
    i8vec4 a_scales;
    const uint16_t laneid = uint16_t(gl_SubgroupInvocationID);
    const uint16_t row = row_begin + (laneid & uint16_t(3));

#if defined(SG_A_SHAPE_16x4)
#ifdef DATA_A_IQK_ROW
    rm_prepare_a_k16x4_iter(block_byte_offset, qs_a, a_scales);
#else
    prepare_a_k16x4_iter(ib_k, qs_a, a_scales);
#endif
    const uint16_t subid = laneid >> uint16_t(2);
    const uint16_t is_high_16 = subid & uint16_t(1);
    const uint16_t cache_half = subid >> uint16_t(1);
    const uint16_t cache_base = cache_half * uint16_t(4);
    const uint qs_base = uint(cache_base) * 2u + uint(is_high_16);

    buf_a_qs[row][qs_base + 0u] = qs_a[0];
    buf_a_qs[row][qs_base + 2u] = qs_a[1];
    buf_a_qs[row][qs_base + 4u] = qs_a[2];
    buf_a_qs[row][qs_base + 6u] = qs_a[3];
    buf_a_s[row][qs_base + 0u] = a_scales[0];
    buf_a_s[row][qs_base + 2u] = a_scales[1];
    buf_a_s[row][qs_base + 4u] = a_scales[2];
    buf_a_s[row][qs_base + 6u] = a_scales[3];
#elif defined(SG_A_SHAPE_32x2)
#ifdef DATA_A_IQK_ROW
    rm_prepare_a_k32x2_iter(block_byte_offset, qs_a, a_scales);
#else
    prepare_a_k32x2_iter(ib_k, qs_a, a_scales);
#endif
    const uint qs_base = uint(laneid >> uint16_t(2)) * 4u;

    buf_a_qs[row][qs_base + 0u] = qs_a[0];
    buf_a_qs[row][qs_base + 1u] = qs_a[1];
    buf_a_qs[row][qs_base + 2u] = qs_a[2];
    buf_a_qs[row][qs_base + 3u] = qs_a[3];
    buf_a_s[row][qs_base + 0u] = a_scales[0];
    buf_a_s[row][qs_base + 1u] = a_scales[1];
    buf_a_s[row][qs_base + 2u] = a_scales[2];
    buf_a_s[row][qs_base + 3u] = a_scales[3];
#else
#error "Unsupported IQK subgroup shape in block_a_to_shmem"
#endif
}

void block_a_to_registers(const uint buf_row) {
    const uint16_t laneid = uint16_t(gl_SubgroupInvocationID);
    const uint16_t qs_base = (laneid % uint16_t(BK_STEP)) * uint16_t(2);

    [[unroll]] for (uint q = 0; q < 2; ++q) {
        cache_a_qs[q] = buf_a_qs[buf_row][qs_base + q];
        cache_a_s[q] = buf_a_s[buf_row][qs_base + q];
    }
}

ACC_TYPE mmq_dot_product(const i32vec4 qs0, const i32vec4 qs1, const int16_t s0, const int16_t s1) {
    int32_t sum0 = dotPacked4x8EXT(qs0.x, cache_b.qs[0])
                 + dotPacked4x8EXT(qs0.y, cache_b.qs[1])
                 + dotPacked4x8EXT(qs0.z, cache_b.qs[2])
                 + dotPacked4x8EXT(qs0.w, cache_b.qs[3]);
    int32_t sum1 = dotPacked4x8EXT(qs1.x, cache_b.qs[4])
                 + dotPacked4x8EXT(qs1.y, cache_b.qs[5])
                 + dotPacked4x8EXT(qs1.z, cache_b.qs[6])
                 + dotPacked4x8EXT(qs1.w, cache_b.qs[7]);
    sum0 = sum0 * s0;
    sum1 = sum1 * s1;

    return ACC_TYPE(float(cache_b.ds.x) * float(sum0 + sum1));
}


#ifdef DATA_A_IQK_ROW
void load_a(uint16_t sgid, uint32_t ir, uint32_t block, uint bytes_in_k, uint a_offset) {
#else
void load_a(uint16_t sgid, uint32_t ir, uint32_t block, uint blk256_in_k, uint a_ib_offset) {
#endif
    const uint16_t laneid = uint16_t(gl_SubgroupInvocationID);
    const uint16_t row_begin = sgid * uint16_t(4);
    const uint first_row = ir * BM + row_begin;
    const uint first_col = block;
    const uint16_t row = laneid & uint16_t(3);
#ifdef DATA_A_IQK_ROW
    const uint a_offset_in_row = IQK_ROW_META_SIZE + (first_col / QUANT_K) * IQK_BLOCK_SIZE;
    const uint a_row_begin = a_offset + (first_row + row) * bytes_in_k;
    block_a_to_shmem(row_begin, a_row_begin + a_offset_in_row);
#else
    const uint a_ib_row = a_ib_offset + first_row * blk256_in_k;
    const uint a_ib_k = a_ib_row + first_col / QUANT_K;
    const uint a_ib_lane = a_ib_k + row * blk256_in_k;
    block_a_to_shmem(row_begin, a_ib_lane);
#endif
}

void load_b(uint16_t sgid, uint16_t sgsize, uint32_t pos_b_ib) {
    const uint16_t laneid = uint16_t(gl_SubgroupInvocationID);
    const uint16_t k_step = laneid / uint16_t(BK / LOAD_VEC_B);
    const uint16_t iqs = laneid % uint16_t(BK / LOAD_VEC_B);

    [[unroll]] for (uint buf_ib = sgid; buf_ib < BN; buf_ib += sgsize) {
#ifdef MUL_MAT_ID
        const u16vec2 row_idx = row_ids[buf_ib];
        const uint ib = pos_b_ib + row_idx.y * p.batch_stride_b / BK + (row_idx.x % p.ne11) * p.stride_b / BK;
#else
        const uint ib = pos_b_ib + buf_ib * p.stride_b / BK;
#endif
        block_b_to_shmem(k_step * BN + buf_ib, ib + k_step, iqs, true);
    }
}


void main() {
    const uint ic = gl_WorkGroupID.y;

#ifdef MUL_MAT_ID
    const uint expert_idx = gl_WorkGroupID.z;
    if (ic * BN >= data_expert_count[expert_idx]) {
        return;
    }
#endif
#if defined(DATA_A_IQ2_K) || defined(DATA_A_IQ2_KS)
    init_iq2k_table();
#elif defined(DATA_A_IQ2_KL)
    init_iq2kl_table();
#elif defined(DATA_A_IQ3_K) || defined(DATA_A_IQ3_KS)
    init_iq3k_table();
#elif defined(DATA_A_IQ4_K) || defined(DATA_A_IQ4_KSS) || defined(DATA_A_IQ4_KS)
    init_iq4k_table();
#elif defined(DATA_A_IQ5_K) || defined(DATA_A_IQ5_KS)
    init_iq5k_table();
#elif defined(NEEDS_INIT_IQ_SHMEM)
    init_iq_shmem(gl_WorkGroupSize);
#endif

#ifndef MUL_MAT_ID
    const uint batch_idx = gl_WorkGroupID.z + p.base_work_group_z;

    const uint i13 = batch_idx / p.ne12;
    const uint i12 = batch_idx % p.ne12;

    const uint i03 = i13 / p.broadcast3;
    const uint i02 = i12 / p.broadcast2;

    const uint batch_idx_a = i03 * p.ne02 + i02;
#endif

    const uint blocks_m = (p.M + BM - 1) / BM;
    const uint ir = gl_WorkGroupID.x % blocks_m;
    const uint ik = gl_WorkGroupID.x / blocks_m;

    const uint WNITER = (WM * WN) / (WARP * TM * TN * WMITER);
    const uint WSUBM = WM / WMITER;
    const uint WSUBN = WN / WNITER;
    const uint16_t subgroup_id = uint16_t(gl_SubgroupID);
    const uint16_t laneid = uint16_t(gl_SubgroupInvocationID);
    const uint16_t subgroup_count = uint16_t(BLOCK_SIZE / WARP);
    const uint16_t load_a_count = uint16_t(BM / 4);

    const uint16_t tiwr = laneid % uint16_t(WSUBM / TM);
    const uint16_t tiwc = laneid / uint16_t(WSUBM / TM);

    const uint16_t warp_r = subgroup_id % uint16_t(BM / WM);
    const uint16_t warp_c = subgroup_id / uint16_t(BM / WM);

#ifdef MUL_MAT_ID
    if (p.hoist_row_ids != 0) {
        load_row_ids_hoisted(expert_idx, ic);
    } else {
        if (bitCount(p.nei0) == 1) {
            load_row_ids(expert_idx, true, ic);
        } else {
            load_row_ids(expert_idx, false, ic);
        }
    }

    // Workgroup has no work
    if (ic * BN >= _ne1) return;
#endif

#ifdef MUL_MAT_ID
    const uint start_k = 0;
    const uint end_k = p.K;
#else
    const uint start_k = ik * p.k_split;
    const uint end_k = min(p.K, (ik + 1) * p.k_split);
#endif

#ifdef MUL_MAT_ID
    uint pos_b_ib = 0;
#else
    uint pos_b_ib = (batch_idx * p.batch_stride_b + ic * BN * p.stride_b + start_k) / BK;
#endif

    ACC_TYPE sums[WMITER * TM * WNITER * TN];

    [[unroll]] for (uint i = 0; i < WMITER*TM*WNITER*TN; i++) {
        sums[i] = ACC_TYPE(0.0f);
    }

    const uint a_offset =
#ifdef MUL_MAT_ID
    expert_idx * p.batch_stride_a;
#else
    batch_idx_a * p.batch_stride_a;
#endif
#ifdef DATA_A_IQK_ROW
    const uint bytes_in_k = IQK_ROW_META_SIZE + (p.K / QUANT_K) * IQK_BLOCK_SIZE;
#else
    const uint blk256_in_k = p.K / QUANT_K;
    const uint a_ib_offset = a_offset / QUANT_K;
#endif

    for (uint block = start_k; block < end_k; block += BK * BK_STEP) {

        if (subgroup_id < load_a_count) {
#ifdef DATA_A_IQK_ROW
            load_a(subgroup_id, ir, block, bytes_in_k, a_offset);
#else
            load_a(subgroup_id, ir, block, blk256_in_k, a_ib_offset);
#endif
        } else {
            load_b(subgroup_id - load_a_count, subgroup_count - load_a_count, pos_b_ib);
        }

        barrier();

        pos_b_ib += BK_STEP;

        const uint buf_row = warp_r * WM + laneid / uint16_t(BK_STEP);
        block_a_to_registers(buf_row);

        ACC_TYPE block_sums[WMITER * TM * WNITER * TN];
        [[unroll]] for (uint i = 0; i < WMITER*TM*WNITER*TN; i++) {
            block_sums[i] = ACC_TYPE(0.0f);
        }
        [[unroll]] for (uint k_step = 0; k_step < BK_STEP; k_step++) {
            const i32vec4 qs0 = subgroupBroadcast(cache_a_qs[0], k_step);
            const i32vec4 qs1 = subgroupBroadcast(cache_a_qs[1], k_step);
            const int16_t s0 = subgroupBroadcast(cache_a_s[0], k_step);
            const int16_t s1 = subgroupBroadcast(cache_a_s[1], k_step);
            const i32vec4 qs2 = subgroupBroadcast(cache_a_qs[0], BK_STEP + k_step);
            const i32vec4 qs3 = subgroupBroadcast(cache_a_qs[1], BK_STEP + k_step);
            const int16_t s2 = subgroupBroadcast(cache_a_s[0], BK_STEP + k_step);
            const int16_t s3 = subgroupBroadcast(cache_a_s[1], BK_STEP + k_step);

            [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
                [[unroll]] for (uint cc = 0; cc < TN; cc++) {
                    const uint ib = k_step * BN + warp_c * WN + wsic * WSUBN + tiwc * TN + cc;
                    block_b_to_registers(ib);

                    [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                        const uint sums_idx = (wsic * TN + cc) * (WMITER * TM) + wsir * TM;

                        block_sums[sums_idx + 0u] += mmq_dot_product(qs0, qs1, s0, s1);
                        block_sums[sums_idx + 1u] += mmq_dot_product(qs2, qs3, s2, s3);
                    }
                }
            }
        }

#ifndef DATA_A_IQK_ROW
        const uint a_ib_row = a_ib_offset + (ir * BM + warp_r * WM) * blk256_in_k;
        const uint a_ib_k = a_ib_row + block / QUANT_K;
        const float a_scale0 = float(data_a[a_ib_k].d);
        const float a_scale1 = float(data_a[a_ib_k + blk256_in_k].d);

        [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
            [[unroll]] for (uint cc = 0; cc < TN; cc++) {
                [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                    const uint sums_idx = (wsic * TN + cc) * (WMITER * TM) + wsir * TM;
                    block_sums[sums_idx + 0u] *= a_scale0;
                    block_sums[sums_idx + 1u] *= a_scale1;
                }
            }
        }
#endif

        [[unroll]] for (uint i = 0; i < WMITER*TM*WNITER*TN; i++) {
            sums[i] += block_sums[i];
        }
        barrier();
    }

#ifdef DATA_A_IQK_ROW
    const uint a_row = ir * BM + warp_r * WM;
    const float a_scale0 = iqks_row_scale(a_offset + a_row * bytes_in_k);
    const float a_scale1 = iqks_row_scale(a_offset + (a_row + 1u) * bytes_in_k);

    [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
        [[unroll]] for (uint cc = 0; cc < TN; cc++) {
            [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                const uint sums_idx = (wsic * TN + cc) * (WMITER * TM) + wsir * TM;
                sums[sums_idx + 0u] *= a_scale0;
                sums[sums_idx + 1u] *= a_scale1;
            }
        }
    }
#endif

    const uint dr = ir * BM + warp_r * WM;
    const uint dc = ic * BN + warp_c * WN;

#ifndef MUL_MAT_ID
    const uint offsets = batch_idx * p.batch_stride_d + ik * p.batch_stride_d * p.num_batches;
#endif

    [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
        [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {

            const uint dr_warp = dr + wsir * WSUBM + tiwr * TM;
            const uint dc_warp = dc + wsic * WSUBN + tiwc * TN;
            [[unroll]] for (uint cc = 0; cc < TN; cc++) {
#ifdef MUL_MAT_ID
                const uint row_i = dc_warp + cc;
                if (row_i >= _ne1) break;

                const u16vec2 row_idx = row_ids[row_i - ic * BN];
#endif // MUL_MAT_ID
                [[unroll]] for (uint cr = 0; cr < TM; cr++) {
                    const uint sums_idx = (wsic * TN + cc) * WMITER * TM + wsir * TM + cr;
#ifdef MUL_MAT_ID
                    if (dr_warp + cr < p.M) {
                        data_d[row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + dr_warp + cr] = D_TYPE(sums[sums_idx].x);
                    }
#else
                    if (dr_warp + cr < p.M && dc_warp + cc < p.N) {
                        data_d[offsets + (dc_warp + cc) * p.stride_d + dr_warp + cr] = D_TYPE(sums[sums_idx].x);
                    }
#endif // MUL_MAT_ID
                }
            }
        }
    }
}
